<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Versioning. Bump here for releases (until we adopt GitVersion / Nerdbank). -->
    <Version>1.0.0</Version>

    <!-- NuGet metadata applied to every shipping project in this repo. -->
    <Authors>Filip Bech-Larsen</Authors>
    <Company>Umbraco Community</Company>
    <Product>Umbraco.Community.AI.Chatbot</Product>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) Filip Bech-Larsen</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/filipbech/Umbraco.Community.AI.Chatbot</PackageProjectUrl>
    <RepositoryUrl>https://github.com/filipbech/Umbraco.Community.AI.Chatbot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Sub-packages stay out of the Umbraco marketplace; the meta-package adds `umbraco-marketplace` itself. -->
    <PackageTags>umbraco;umbraco-ai;chatbot;rag;ai;chat;widget</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Pack the README + icon at the package root so nuget.org renders them on each package's listing. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)assets\icon.png')" />
  </ItemGroup>
</Project>
