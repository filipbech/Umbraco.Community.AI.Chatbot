# Force LF on source so Windows checkouts don't accidentally commit CRLF.
* text=auto eol=lf

*.cs    text eol=lf diff=csharp
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.ts    text eol=lf
*.html  text eol=lf
*.cshtml text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.gif   binary
*.snk   binary
*.pfx   binary
