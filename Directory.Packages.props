<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Umbraco CMS -->
    <PackageVersion Include="Umbraco.Cms.Core" Version="[17.3.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[17.3.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="[17.3.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore" Version="[17.3.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.SqlServer" Version="[17.3.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Persistence.EFCore.Sqlite" Version="[17.3.0, 17.999.999)" />
    <PackageVersion Include="Umbraco.Cms.Search.Core" Version="[1.0.0-beta.5, 1.999.999)" />

    <!-- Umbraco.AI suite (consumed as NuGet) -->
    <PackageVersion Include="Umbraco.AI.Core" Version="[1.10.1, 1.999.999)" />
    <PackageVersion Include="Umbraco.AI.Web" Version="[1.10.1, 1.999.999)" />
    <PackageVersion Include="Umbraco.AI.Startup" Version="[1.10.1, 1.999.999)" />
    <PackageVersion Include="Umbraco.AI.Agent.Core" Version="[1.9.0, 1.999.999)" />
    <PackageVersion Include="Umbraco.AI.Agent.Startup" Version="[1.9.0, 1.999.999)" />
    <PackageVersion Include="Umbraco.AI.Search.Core" Version="[1.0.0-alpha1, 1.999.999)" />

    <!-- Microsoft.Extensions.AI -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.4, 10.999.999)" />

    <!-- EF Core tooling -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="[10.0.4, 10.999.999)" />

    <!-- Test packages -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
